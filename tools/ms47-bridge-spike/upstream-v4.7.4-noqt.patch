-inline muse::logger::Stream& operator<<(muse::logger::Stream& s, const muse::String& str)
+namespace muse {
+// In namespace muse so ADL finds them from any namespace; the && overload serves temporaries (LOGD() << str).
+// Without Qt there is no QString conversion to fall back on.
+inline logger::Stream& operator<<(logger::Stream& s, const String& str)
 {
     s << str.toUtf8().constChar();
     return s;
 }
 
+inline logger::Stream& operator<<(logger::Stream&& s, const String& str)
+{
+    return s << str;
+}
