{
  "version": "2026-07-17.2",
  "rules": [
    {
      "id": "openai-gpt-4-multimodal",
      "provider": "openai",
      "modelPattern": "^gpt-(?:4o|4\\.1)(?:[-.]|$)",
      "capabilities": {
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "supported", "min": 0, "max": 2 }
        }
      },
      "evidence": {
        "url": "https://developers.openai.com/api/docs/models",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "openai-gpt-5-reasoning",
      "provider": "openai",
      "modelPattern": "^gpt-5(?:[-.]|$)",
      "capabilities": {
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "unsupported" },
          "reasoning": { "support": "supported" }
        }
      },
      "evidence": {
        "url": "https://developers.openai.com/api/docs/models",
        "verifiedAt": "2026-07-17",
        "note": "Sampling controls are omitted for GPT-5 reasoning models unless a later exact-model rule allows them."
      }
    },
    {
      "id": "openai-o-series-reasoning",
      "provider": "openai",
      "modelPattern": "^o[1-9](?:[-.]|$)",
      "capabilities": {
        "inputs": { "text": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "unsupported" },
          "reasoning": { "support": "supported" }
        }
      },
      "evidence": {
        "url": "https://developers.openai.com/api/docs/models",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "anthropic-claude-3-and-4",
      "provider": "anthropic",
      "modelPattern": "^claude-(?:3|sonnet-4|haiku-4)(?:[-.]|$)",
      "capabilities": {
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "supported", "min": 0, "max": 1 }
        }
      },
      "evidence": {
        "url": "https://platform.claude.com/docs/en/api/messages/create",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "anthropic-opus-4-7-4-8",
      "provider": "anthropic",
      "modelPattern": "^claude-opus-4-(?:7|8)(?:[-.]|$)",
      "capabilities": {
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "unsupported" },
          "reasoning": { "support": "supported" }
        }
      },
      "evidence": {
        "url": "https://platform.claude.com/docs/en/about-claude/models/whats-new-claude-4-8",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "anthropic-opus-4-6",
      "provider": "anthropic",
      "modelPattern": "^claude-opus-4-6$",
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 131072,
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1, "max": 131072 },
          "temperature": { "support": "supported", "min": 0, "max": 1 },
          "reasoning": { "support": "supported", "modes": ["off", "enabled", "adaptive"] }
        }
      },
      "evidence": {
        "url": "https://platform.claude.com/docs/en/about-claude/models/migration-guide",
        "verifiedAt": "2026-07-17",
        "note": "Opus 4.6 predates Anthropic's removal of non-default sampling parameters. Live Models API metadata may refine its limits and capability flags."
      }
    },
    {
      "id": "anthropic-sonnet-5",
      "provider": "anthropic",
      "modelPattern": "^claude-sonnet-5$",
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 131072,
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1, "max": 131072 },
          "temperature": { "support": "unsupported" },
          "reasoning": {
            "support": "supported",
            "modes": ["off", "adaptive"],
            "default": "adaptive"
          }
        }
      },
      "evidence": {
        "url": "https://platform.claude.com/docs/en/about-claude/models/whats-new-sonnet-5",
        "verifiedAt": "2026-07-17",
        "note": "OTS omits temperature because non-default sampling values return 400; the backwards-compatible default value does not provide a useful control."
      }
    },
    {
      "id": "anthropic-fable-5",
      "provider": "anthropic",
      "modelPattern": "^claude-fable-5$",
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 131072,
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1, "max": 131072 },
          "temperature": { "support": "unsupported" },
          "reasoning": { "support": "supported", "modes": ["adaptive"], "default": "adaptive" }
        }
      },
      "evidence": {
        "url": "https://platform.claude.com/docs/en/about-claude/models/introducing-claude-fable-5-and-claude-mythos-5",
        "verifiedAt": "2026-07-17",
        "note": "Fable 5 has always-on adaptive thinking. OTS omits the deprecated temperature parameter used only for backwards compatibility."
      }
    },
    {
      "id": "gemini-generative-multimodal",
      "provider": "gemini",
      "modelPattern": "^gemini-(?:1\\.5|2(?:\\.0|\\.5)?|3(?:\\.0|\\.1)?)-",
      "capabilities": {
        "inputs": { "text": "supported", "image": "supported", "pdf": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "supported", "min": 0 }
        }
      },
      "evidence": {
        "url": "https://ai.google.dev/api/models",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "gemini-3-5-flash",
      "provider": "gemini",
      "modelPattern": "^gemini-3\\.5-flash$",
      "capabilities": {
        "contextWindow": 1048576,
        "maxOutputTokens": 65536,
        "inputs": {
          "text": "supported",
          "image": "supported",
          "pdf": "supported",
          "video": "supported"
        },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1, "max": 65536 },
          "temperature": { "support": "supported", "min": 0 },
          "reasoning": { "support": "supported" }
