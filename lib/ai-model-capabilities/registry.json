    {
      "id": "deepseek-chat",
      "provider": "deepseek",
      "modelPattern": "^deepseek-chat$",
      "capabilities": {
        "inputs": { "text": "supported", "image": "unsupported", "pdf": "unsupported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "supported", "min": 0, "max": 2 },
          "reasoning": { "support": "supported", "modes": ["off", "on"] }
        }
      },
      "evidence": {
        "url": "https://api-docs.deepseek.com/api/create-chat-completion",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "deepseek-reasoner",
      "provider": "deepseek",
      "modelPattern": "^deepseek-reasoner$",
      "capabilities": {
        "inputs": { "text": "supported", "image": "unsupported", "pdf": "unsupported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "unsupported" },
          "reasoning": { "support": "supported", "default": "on" }
        }
      },
      "evidence": {
        "url": "https://api-docs.deepseek.com/guides/reasoning_model",
        "verifiedAt": "2026-07-17"
      }
    },
    {
      "id": "deepseek-v4",
      "provider": "deepseek",
      "modelPattern": "^deepseek-v4-(?:flash|pro)$",
      "capabilities": {
        "contextWindow": 1000000,
        "maxOutputTokens": 393216,
        "inputs": { "text": "supported", "image": "unsupported", "pdf": "unsupported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1, "max": 393216 },
          "temperature": { "support": "supported", "min": 0, "max": 2, "default": 1 },
          "reasoning": { "support": "supported", "modes": ["off", "on"], "default": "on" }
        }
      },
      "evidence": {
        "url": "https://api-docs.deepseek.com/quick_start/pricing/",
        "verifiedAt": "2026-07-17",
        "note": "Both V4 variants share the documented 1M context, 384K maximum output, and default-on thinking contract."
      }
    },
    {
      "id": "kimi-k2-5-2-6",
      "provider": "kimi",
      "modelPattern": "^kimi-k2\\.(?:5|6)(?:[-.]|$)",
      "capabilities": {
        "inputs": {
          "text": "supported",
          "image": "supported",
          "pdf": "unsupported",
          "video": "supported"
        },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "unsupported" },
          "reasoning": { "support": "supported", "modes": ["off", "on"] }
        }
      },
      "evidence": {
        "url": "https://platform.kimi.ai/docs/guide/migrating-from-openai-to-kimi",
        "verifiedAt": "2026-07-17",
        "note": "OTS omits temperature until it exposes Kimi thinking mode because the permitted value depends on that mode."
      }
    },
    {
      "id": "kimi-k2-7-code",
      "provider": "kimi",
      "modelPattern": "^kimi-k2\\.7-code(?:-highspeed)?$",
      "capabilities": {
        "contextWindow": 262144,
        "inputs": {
          "text": "supported",
          "image": "supported",
          "pdf": "unsupported",
          "video": "supported"
        },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "supported", "fixed": 1 },
          "reasoning": { "support": "supported", "modes": ["on"], "default": "on" }
        }
      },
      "evidence": {
        "url": "https://platform.kimi.ai/docs/guide/kimi-k2-7-code-quickstart",
        "verifiedAt": "2026-07-17",
        "note": "The high-speed ID is the same model with identical limits. OTS hides temperature because it is fixed at 1.0."
      }
    },
    {
      "id": "kimi-k3",
      "provider": "kimi",
      "modelPattern": "^kimi-k3$",
      "capabilities": {
        "contextWindow": 1048576,
        "maxOutputTokens": 1048576,
        "inputs": {
          "text": "supported",
          "image": "supported",
          "pdf": "unsupported",
          "video": "supported"
        },
        "parameters": {
          "maxOutputTokens": {
            "support": "supported",
            "min": 1,
            "max": 1048576,
            "default": 131072
          },
          "temperature": { "support": "supported", "fixed": 1 },
          "reasoning": { "support": "supported", "modes": ["max"], "default": "max" }
        }
      },
      "evidence": {
        "url": "https://platform.kimi.ai/docs/guide/kimi-k3-quickstart",
        "verifiedAt": "2026-07-17",
        "note": "K3 always reasons at the currently fixed max effort. OTS hides temperature because it is fixed at 1.0."
      }
    }
  ]
}
