      },
      "evidence": {
        "url": "https://ai.google.dev/gemini-api/docs/models/gemini-3.5-flash",
        "verifiedAt": "2026-07-17",
        "note": "Live Gemini metadata remains authoritative for the default and maximum temperature."
      }
    },
    {
      "id": "grok-3-4-generative",
      "provider": "grok",
      "modelPattern": "^grok-(?:3|4)(?:[-.]|$)",
      "capabilities": {
        "inputs": { "text": "supported" },
        "parameters": {
          "maxOutputTokens": { "support": "supported", "min": 1 },
          "temperature": { "support": "supported", "min": 0, "max": 2 }
        }
      },
      "evidence": {
        "url": "https://docs.x.ai/developers/rest-api-reference/inference/chat",
        "verifiedAt": "2026-07-17"
