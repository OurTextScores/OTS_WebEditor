{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "tsBuildInfoFile": "./.cache/typescript/app.tsbuildinfo"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "types/**/*.d.ts",
    "next.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".claude",
    ".next",
    ".next-dev-*",
    "webmscore-fork",
    "unit",
    "tests",
    "out",
    "release",
    "build"
  ]
}
