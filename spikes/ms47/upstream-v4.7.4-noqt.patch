diff --git a/src/framework/global/types/string.h b/src/framework/global/types/string.h
index cce1c7f376..e8f310bb0f 100644
--- a/src/framework/global/types/string.h
+++ b/src/framework/global/types/string.h
@@ -500,24 +500,40 @@ struct std::hash<muse::String>
     std::size_t operator()(const muse::String& s) const noexcept { return s.hash(); }
 };
 
-inline muse::logger::Stream& operator<<(muse::logger::Stream& s, const muse::String& str)
+namespace muse {
+// In namespace muse so ADL finds them from any namespace; the && overload serves temporaries (LOGD() << str).
+// Without Qt there is no QString conversion to fall back on.
+inline logger::Stream& operator<<(logger::Stream& s, const String& str)
 {
     s << str.toUtf8().constChar();
     return s;
 }
 
+inline logger::Stream& operator<<(logger::Stream&& s, const String& str)
+{
+    return s << str;
+}
+}
+
 // ============================
 // AsciiStringView (ASCII)
 // ============================
 inline bool operator ==(const char* s1, const muse::AsciiStringView& s2) { return s2 == s1; }
 inline bool operator !=(const char* s1, const muse::AsciiStringView& s2) { return s2 != s1; }
 
-inline muse::logger::Stream& operator<<(muse::logger::Stream& s, const muse::AsciiStringView& str)
+namespace muse {
+inline logger::Stream& operator<<(logger::Stream& s, const AsciiStringView& str)
 {
     s << str.ascii();
     return s;
 }
 
+inline logger::Stream& operator<<(logger::Stream&& s, const AsciiStringView& str)
+{
+    return s << str;
+}
+}
+
 #ifndef muPrintable
 #  define muPrintable(string) string.toUtf8().constChar()
 #endif
