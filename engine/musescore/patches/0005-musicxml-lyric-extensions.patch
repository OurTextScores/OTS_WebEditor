+// Stop a numbered extension at the end of its explicit stop note. Keep verses
+// and voices independent; a stop-only lyric has no Lyrics object for setExtend.
+void MusicXmlLyricsExtend::stopExplicitExtend(int verse, track_idx_t track, const Fraction& tick)
+{
+    std::vector<Lyrics*> finished;
+    for (Lyrics* lyric : m_lyrics) {
+        const EngravingItem* parent = lyric->parentItem();
+        if (!parent || !parent->isChordRest() || parent->track() != track || lyric->verse() != verse) {
+            continue;
+        }
+        const ChordRest* start = toChordRest(parent);
+        const Fraction last = lastChordTicks(lyric->segment(), tick, track);
+        if (last > Fraction(0, 1)) {
+            lyric->setTicks(tick - start->tick() - last);
+        }
+        finished.push_back(lyric);
+    }
+    for (Lyrics* lyric : finished) muse::remove(m_lyrics, lyric);
+}
