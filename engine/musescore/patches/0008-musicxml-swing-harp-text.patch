+/**
+ OTS (roadmap E23): words that are exactly a harp pedal setting written as text, as the exporter writes a text-form
+ HarpPedalDiagram: each of the seven pedal steps once, each followed by a flat, natural or sharp (Unicode or the SMuFL
+ text glyphs). Fills `state` (indexed by HarpStringType).
+ */
+static bool harpPedalTextState(const String& plain, std::array<PedalPosition, HARP_STRING_NO>& state)
+{
+    static const String steps = u"DCBEFGA";
+    std::array<bool, HARP_STRING_NO> seen {};
+    int found = 0;
+    for (size_t i = 0; i < plain.size(); ++i) {
+        const char16_t c = plain.at(i).unicode();
+        if (c == u' ' || c == u'\n' || c == u'\t') {
+            continue;
+        }
+        const size_t step = steps.indexOf(Char(c));
+        if (step == muse::nidx || seen[step] || i + 1 >= plain.size()) {
+            return false;
+        }
+        const char16_t accidental = plain.at(++i).unicode();
+        if (accidental == 0x266D || accidental == 0xED60) {
+            state[step] = PedalPosition::FLAT;
+        } else if (accidental == 0x266E || accidental == 0xED61) {
+            state[step] = PedalPosition::NATURAL;
+        } else if (accidental == 0x266F || accidental == 0xED62) {
+            state[step] = PedalPosition::SHARP;
+        } else {
+            return false;
+        }
+        seen[step] = true;
+        ++found;
+    }
+    return found == HARP_STRING_NO;
+}
